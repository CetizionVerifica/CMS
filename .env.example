# Copy to .env for local overrides. Values match docker/compose.yaml.
DATABASE_URL=postgres://canopy:canopy@localhost:5432/canopy
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=canopy-evidence
S3_ACCESS_KEY_ID=canopy
S3_SECRET_ACCESS_KEY=canopy-secret
API_PORT=4000
# Seals MFA secrets; the API refuses to start with DATABASE_URL but no key. Generate one: openssl rand -base64 32
AUTH_SECRET_KEY=
