{
  "$description": "Canopy design tokens (W3C Design Tokens format). Mirror of foundations.md. Entries with \"new\": true are proposed in change-requests.md.",
  "color": {
    "forest": { "$type": "color", "$value": "#1F6B47" },
    "forest-hover": { "$type": "color", "$value": "#185A3B", "new": true },
    "leaf": { "$type": "color", "$value": "#2F8F60" },
    "moss": { "$type": "color", "$value": "#A9C97A" },
    "sage": { "$type": "color", "$value": "#D9E8DC" },
    "mist": { "$type": "color", "$value": "#F5F7F4" },
    "surface": { "$type": "color", "$value": "#FFFFFF" },
    "ink": { "$type": "color", "$value": "#13221A" },
    "muted": { "$type": "color", "$value": "#5F6F66" },
    "line": { "$type": "color", "$value": "#E1E7E2" },
    "line-strong": { "$type": "color", "$value": "#7A8A81", "new": true },
    "ok": { "$type": "color", "$value": "#1E8A55" },
    "warn": { "$type": "color", "$value": "#B97A06" },
    "crit": { "$type": "color", "$value": "#C0442A" },
    "ok-ink": { "$type": "color", "$value": "#176B42", "new": true },
    "warn-ink": { "$type": "color", "$value": "#8C5C04", "new": true },
    "crit-ink": { "$type": "color", "$value": "#A8391F", "new": true },
    "ok-soft": { "$type": "color", "$value": "#E3F3EA", "new": true },
    "warn-soft": { "$type": "color", "$value": "#FBF0D9", "new": true },
    "crit-soft": { "$type": "color", "$value": "#FBE5DF", "new": true },
    "neutral-soft": { "$type": "color", "$value": "#EEF1EF", "new": true },
    "on-forest": { "$type": "color", "$value": "#FFFFFF", "new": true },
    "on-forest-muted": { "$type": "color", "$value": "#CFE3D6", "new": true },
    "on-forest-hover": { "$type": "color", "$value": "rgba(255,255,255,0.08)", "new": true },
    "on-forest-selected": { "$type": "color", "$value": "rgba(255,255,255,0.13)", "new": true },
    "scrim": { "$type": "color", "$value": "rgba(19,34,26,0.40)", "new": true }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "$value": ["Plus Jakarta Sans", "system-ui", "-apple-system", "Segoe UI", "sans-serif"]
    }
  },
  "type": {
    "kpi": { "size": "26px", "lineHeight": "30px", "weight": 800, "tracking": "-0.02em" },
    "page": { "size": "20px", "lineHeight": "26px", "weight": 800, "tracking": "-0.01em" },
    "section": { "size": "16px", "lineHeight": "22px", "weight": 700 },
    "card": { "size": "14px", "lineHeight": "20px", "weight": 800 },
    "body": { "size": "14px", "lineHeight": "21px", "weight": 500 },
    "body-strong": { "size": "14px", "lineHeight": "21px", "weight": 700 },
    "meta": { "size": "12px", "lineHeight": "16px", "weight": 600 },
    "label": {
      "size": "12px",
      "lineHeight": "16px",
      "weight": 600,
      "tracking": "0.05em",
      "transform": "uppercase"
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "3h": { "$type": "dimension", "$value": "14px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "22px" },
    "6": { "$type": "dimension", "$value": "32px", "new": true },
    "7": { "$type": "dimension", "$value": "48px", "new": true }
  },
  "radius": {
    "card": { "$type": "dimension", "$value": "12px" },
    "control": { "$type": "dimension", "$value": "9px" },
    "chip": { "$type": "dimension", "$value": "8px" },
    "tag": { "$type": "dimension", "$value": "6px", "new": true },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "size": {
    "control": { "$type": "dimension", "$value": "36px" },
    "control-compact": { "$type": "dimension", "$value": "32px" },
    "control-touch": { "$type": "dimension", "$value": "44px" },
    "sidebar": { "$type": "dimension", "$value": "212px" },
    "rail": { "$type": "dimension", "$value": "64px" },
    "topbar": { "$type": "dimension", "$value": "56px" },
    "drawer-lg": { "$type": "dimension", "$value": "560px" },
    "drawer-md": { "$type": "dimension", "$value": "480px" }
  },
  "shadow": {
    "overlay": {
      "$type": "shadow",
      "$value": "0 12px 32px -12px rgba(19,34,26,.28), 0 2px 6px rgba(19,34,26,.08)"
    }
  },
  "z": { "sticky": 10, "shell": 20, "drawer": 40, "popover": 50, "dialog": 60, "toast": 70 },
  "motion": {
    "ease-out": "cubic-bezier(.2,0,0,1)",
    "dur-fast": "120ms",
    "dur-base": "200ms",
    "dur-slow": "260ms"
  },
  "breakpoint": { "sm": "640px", "lg": "1100px" },
  "focus": { "width": "2px", "offset": "2px", "color": "{color.forest}" }
}
