{
  "name": "@canopy/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.mjs",
    "platform:add-operator": "tsx src/platform/add-operator.ts"
  },
  "canopy": {
    "seed": "./src/modules/imports/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@canopy/contracts": "workspace:*",
    "@canopy/db": "workspace:*",
    "@canopy/engine": "workspace:*",
    "@canopy/importer": "workspace:*",
    "@canopy/notifications": "workspace:*",
    "@fastify/cookie": "catalog:",
    "@fastify/rate-limit": "catalog:",
    "exceljs": "^4.4.0",
    "fastify": "catalog:",
    "nodemailer": "^10.1.0",
    "pdf-lib": "^1.17.1",
    "pg-boss": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@canopy/tsconfig": "workspace:*",
    "@canopy/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "pg": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
